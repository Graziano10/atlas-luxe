# //.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# The canonical public URL of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── CMS / Data API ────────────────────────────────────────────────────────────
# Replace with your Sanity, Contentful, or custom API credentials.
# NEXT_PUBLIC_ prefix exposes the variable to the browser bundle — only use it
# for values that are safe to be public (e.g. dataset name, project ID).

# CMS_API_URL=https://api.example.com
# CMS_API_KEY=your-secret-api-key

# ── Email / Enquiry service ───────────────────────────────────────────────────
# Used by the server-side enquiry handler to forward submissions.

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ENQUIRY_TO_EMAIL=enquiries@atlas-luxe.com
# ENQUIRY_FROM_EMAIL=noreply@atlas-luxe.com

# ── Newsletter service (e.g. Mailchimp, Klaviyo) ─────────────────────────────

# NEWSLETTER_API_KEY=your-newsletter-api-key
# NEWSLETTER_LIST_ID=your-list-id

# ── Analytics ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Feature flags ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ENABLE_MEMBERSHIP=false
